
# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENROUTER_API_KEY: Optional fallback when using OpenRouter provider on server/Vercel.
OPENROUTER_API_KEY=""

# VITE_SUPABASE_URL: Supabase Project URL (Client & Server)
VITE_SUPABASE_URL=""
SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: Supabase Public Anon Key (Client & Server)
VITE_SUPABASE_ANON_KEY=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Contact Form Email Delivery (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
CONTACT_EMAIL=""
