{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx vite build && node scripts/seo.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/en",
      "destination": "/en/index.html"
    },
    {
      "source": "/en/privacy",
      "destination": "/en/index.html"
    },
    {
      "source": "/es",
      "destination": "/es/index.html"
    },
    {
      "source": "/es/privacy",
      "destination": "/es/index.html"
    },
    {
      "source": "/fr",
      "destination": "/fr/index.html"
    },
    {
      "source": "/fr/privacy",
      "destination": "/fr/index.html"
    },
    {
      "source": "/de",
      "destination": "/de/index.html"
    },
    {
      "source": "/de/privacy",
      "destination": "/de/index.html"
    },
    {
      "source": "/en/terms",
      "destination": "/en/index.html"
    },
    {
      "source": "/es/terms",
      "destination": "/es/index.html"
    },
    {
      "source": "/fr/terms",
      "destination": "/fr/index.html"
    },
    {
      "source": "/de/terms",
      "destination": "/de/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
